# Live features (presence, live cursors, guestbook, global leaderboards).
# Leave VITE_LIVE unset or false and the site works without any of it.
VITE_LIVE=false

# Supabase → Project Settings → API. The anon key is public by design;
# row-level security and the `submit` Edge Function keep the data safe.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
